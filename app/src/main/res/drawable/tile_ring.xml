<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape><corners android:radius="14dp" />
            <stroke android:width="2.5dp" android:color="@color/accent" android:dashWidth="9dp" android:dashGap="5dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="14dp" /><stroke android:width="2.5dp" android:color="#FFFFFF" /></shape>
    </item>
    <item><shape><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#1AFFFFFF" /></shape></item>
</selector>
