<resources>
    <style name="Theme.AttuneTV" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="SectionLabel">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
