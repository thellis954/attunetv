<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView android:id="@+id/photo_a" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/photo_b" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/ambient_shade" />

    <LinearLayout
        android:id="@+id/ambient_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <TextClock android:id="@+id/ambient_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontVariationSettings="'wght' 200" android:includeFontPadding="false" android:letterSpacing="-0.02"
            android:shadowColor="#80000000" android:shadowRadius="24" android:textColor="#FFFFFF" android:textSize="96sp" />
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d" android:format24Hour="EEEE, MMMM d" android:fontVariationSettings="'wght' 500"
            android:shadowColor="#80000000" android:shadowRadius="12" android:textColor="#E6FFFFFF" android:textSize="18sp" />
        <TextView android:id="@+id/ambient_weather" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:fontVariationSettings="'wght' 600" android:shadowColor="#80000000"
            android:shadowRadius="12" android:textColor="#FFFFFF" android:textSize="16sp" />
        <LinearLayout android:id="@+id/ambient_forecast" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="horizontal" />
        <TextView android:id="@+id/ambient_agenda" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:fontVariationSettings="'wght' 500" android:lineSpacingExtra="5dp"
            android:shadowColor="#80000000" android:shadowRadius="12" android:textColor="#E6FFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <TextView android:id="@+id/ambient_caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_marginEnd="40dp" android:layout_marginBottom="28dp"
        android:fontVariationSettings="'wght' 500" android:maxWidth="320dp" android:gravity="end"
        android:shadowColor="#80000000" android:shadowRadius="10" android:textColor="#B3FFFFFF" android:textSize="11sp" />
</FrameLayout>
