<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/search_wall" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#C00B1020" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/search" android:textSize="30sp" android:textColor="#FFFFFF" android:fontVariationSettings="'wght' 620" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/search_description" android:textSize="13sp" android:textColor="#CCFFFFFF" android:layout_marginTop="3dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="18dp" android:gravity="center_vertical">
            <EditText android:id="@+id/search_query" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:hint="@string/search_apps_hint" android:inputType="text"
                android:imeOptions="actionSearch" android:singleLine="true" android:textSize="18sp"
                android:textColor="#FFFFFF" android:textColorHint="#B3FFFFFF" android:paddingHorizontal="14dp"
                android:background="@drawable/search_field" android:nextFocusRight="@id/search_movies"
                android:nextFocusDown="@id/search_grid" />
            <Button android:id="@+id/search_movies" style="@style/Pill" android:layout_width="230dp"
                android:layout_height="48dp" android:layout_marginStart="14dp" android:text="@string/search_movies"
                android:nextFocusLeft="@id/search_query" android:nextFocusDown="@id/search_grid" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end"
            android:layout_marginTop="7dp" android:text="@string/search_catalogue_hint" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        <TextView android:id="@+id/search_count" style="@style/SectionLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/search_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="@string/search_empty" android:textSize="17sp"
            android:textColor="#FFFFFF" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_grid" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:padding="10dp"
            android:clipToPadding="false" android:clipChildren="false" android:nextFocusUp="@id/search_query" />
        <TextView android:id="@+id/search_selection" android:layout_width="match_parent" android:layout_height="42dp"
            android:text="@string/search_hint" android:gravity="center_vertical" android:textSize="17sp" android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
