<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic backdrop (two layers for cross-fade) + scrim for legibility -->
    <ImageView android:id="@+id/backdrop_a" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/backdrop_b" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <View android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/gutter">

        <!-- Header: clock + glass widgets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="44sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, MMMM d"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/weather_widget"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:background="@drawable/glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <TextView android:id="@+id/wx_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="28sp" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/wx_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light" android:includeFontPadding="false"
                        android:textColor="@color/text" android:textSize="26sp" />
                    <TextView android:id="@+id/wx_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:maxWidth="170dp" android:maxLines="2" android:ellipsize="end"
                        android:textColor="@color/text_dim" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calendar_widget"
                android:layout_width="250dp"
                android:layout_height="72dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/glass"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:text="@string/up_next" />
                <TextView android:id="@+id/cal_1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
                    android:textColor="@color/text" android:textSize="13sp" />
                <TextView android:id="@+id/cal_2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="@color/text_dim" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hero line: focused app name + quick actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/focus_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <Button android:id="@+id/btn_inputs" style="@style/Pill" android:text="@string/inputs" />
            <Button android:id="@+id/btn_ambient" style="@style/Pill" android:text="@string/ambient" />
            <Button android:id="@+id/btn_settings" style="@style/Pill" android:text="@string/settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/setup_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/pill_bg"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/setup_banner"
            android:textColor="@color/pill_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/scroller"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Glass dock of favorites -->
                <FrameLayout
                    android:id="@+id/dock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/glass"
                    android:clipChildren="false"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/favorites"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/recent_label"
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/recent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false" />

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/all_apps" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/hint"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
