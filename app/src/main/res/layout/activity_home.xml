<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Background stack: daily photo, its blurred twin (all-apps view), color glow, legibility shade -->
    <ImageView android:id="@+id/wall" android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <ImageView android:id="@+id/wall_blur" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:importantForAccessibility="no" android:scaleType="centerCrop" />
    <View android:id="@+id/glow" android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:id="@+id/shade" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/shade" />

    <!-- ===================== HOME ===================== -->
    <FrameLayout android:id="@+id/home_layer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter" android:layout_marginTop="28dp" android:orientation="vertical">

            <TextView android:id="@+id/greeting" style="@style/SectionLabel" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#BFFFFFFF" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:gravity="bottom" android:orientation="horizontal">
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="h:mm" android:format24Hour="HH:mm"
                    android:fontVariationSettings="'wght' 200" android:includeFontPadding="false"
                    android:letterSpacing="-0.02" android:textColor="#FFFFFF" android:textSize="66sp" />
                <TextClock android:id="@+id/ampm" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:layout_marginBottom="8dp" android:format12Hour="a"
                    android:format24Hour="" android:fontVariationSettings="'wght' 500" android:textColor="#D9FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:format12Hour="EEEE, MMMM d" android:format24Hour="EEEE, MMMM d"
                android:fontVariationSettings="'wght' 500" android:textColor="#D9FFFFFF" android:textSize="14sp" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/chip_weather" style="@style/Chip" android:visibility="gone">
                    <TextView android:id="@+id/wx_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="13sp" />
                    <TextView android:id="@+id/wx_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:fontVariationSettings="'wght' 650"
                        android:textColor="#FFFFFF" android:textSize="12sp" />
                    <TextView android:id="@+id/wx_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:fontVariationSettings="'wght' 500"
                        android:textColor="#B3FFFFFF" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/chip_cal" style="@style/Chip" android:layout_marginStart="8dp"
                    android:visibility="gone">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_calendar"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/cal_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="7dp" android:ellipsize="end" android:maxWidth="220dp" android:maxLines="1"
                        android:fontVariationSettings="'wght' 650" android:textColor="#FFFFFF" android:textSize="12sp" />
                    <TextView android:id="@+id/cal_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:fontVariationSettings="'wght' 500"
                        android:textColor="#B3FFFFFF" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="28dp" android:layout_marginEnd="@dimen/gutter"
            android:orientation="horizontal">
            <ImageButton android:id="@+id/btn_inputs" style="@style/RoundButton" android:contentDescription="@string/inputs"
                android:src="@drawable/ic_input" />
            <ImageButton android:id="@+id/btn_ambient" style="@style/RoundButton" android:contentDescription="@string/ambient"
                android:src="@drawable/ic_moon" />
            <ImageButton android:id="@+id/btn_settings" style="@style/RoundButton" android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <TextView android:id="@+id/setup_banner" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="80dp" android:layout_marginEnd="@dimen/gutter"
            android:background="@drawable/pill_bg" android:focusable="true" android:paddingStart="14dp"
            android:paddingTop="7dp" android:paddingEnd="14dp" android:paddingBottom="7dp" android:text="@string/setup_banner"
            android:textColor="@color/pill_text" android:textSize="12sp" android:visibility="gone" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_marginStart="44dp" android:layout_marginBottom="188dp"
            android:orientation="vertical">
            <TextView android:id="@+id/focus_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:ellipsize="end" android:fontVariationSettings="'wght' 620" android:maxLines="1"
                android:shadowColor="#66000000" android:shadowRadius="18" android:textColor="#FFFFFF" android:textSize="34sp" />
            <TextView android:id="@+id/focus_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 500" android:textColor="#BFFFFFFF" android:textSize="12.5sp" />
        </LinearLayout>

        <FrameLayout android:id="@+id/dock" android:layout_width="match_parent" android:layout_height="126dp"
            android:layout_gravity="bottom" android:layout_marginStart="28dp" android:layout_marginEnd="28dp"
            android:layout_marginBottom="58dp" android:clipChildren="false" android:paddingStart="10dp"
            android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/favorites" android:layout_width="match_parent"
                android:layout_height="match_parent" android:clipChildren="false" android:clipToPadding="false" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/peek" android:layout_width="match_parent"
            android:layout_height="106dp" android:layout_gravity="bottom" android:layout_marginStart="38dp"
            android:alpha="0.85" android:descendantFocusability="blocksDescendants" android:focusable="false"
            android:translationY="68dp" />
    </FrameLayout>

    <!-- ===================== ALL APPS ===================== -->
    <FrameLayout android:id="@+id/apps_layer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:visibility="gone">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="44dp" android:layout_marginTop="30dp" android:gravity="bottom"
            android:orientation="horizontal">
            <TextView android:id="@+id/apps_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:ellipsize="end" android:fontVariationSettings="'wght' 620" android:maxLines="1" android:maxWidth="520dp"
                android:textColor="#FFFFFF" android:textSize="30sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_marginBottom="6dp" android:fontVariationSettings="'wght' 500"
                android:text="@string/hint" android:textColor="#B3FFFFFF" android:textSize="12.5sp" />
        </LinearLayout>

        <TextView android:id="@+id/apps_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="36dp" android:layout_marginEnd="44dp"
            android:fontVariationSettings="'wght' 300" android:textColor="#FFFFFF" android:textSize="20sp" />

        <TextView android:id="@+id/apps_label" style="@style/SectionLabel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="44dp" android:layout_marginTop="84dp"
            android:textColor="#B3FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_marginTop="100dp" android:clipChildren="false"
            android:clipToPadding="false" android:paddingStart="36dp" android:paddingEnd="36dp"
            android:paddingBottom="40dp" android:paddingTop="8dp" />
    </FrameLayout>
</FrameLayout>
